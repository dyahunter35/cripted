# Crypto & Stego Lab — Environment Variables
# Copy to .env.local for local development.

# Optional: Gemini API Key for generating educational podcasts
# NOTE: Used ONLY during build or offline generation script (scripts/generate-podcasts.ts).
# NEVER expose this key in NEXT_PUBLIC_* variables or browser code!
GEMINI_API_KEY=your_gemini_api_key_here

# Optional base path override (defaults to /cripted in production, empty in development)
NEXT_PUBLIC_BASE_PATH=
